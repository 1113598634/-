    // 删除人物节点
    function confirmDeletePerson() {
      const totalCount = Object.keys(state.people).length;
      if (totalCount <= 1) {
        showToast('族谱至少需要保留一位核心人物，无法删除最后一个节点');
        return;
      }

      const person = state.people[state.selectedId];
      if (!person) return;

      showConfirmDialog(
        `删除人物【${person.name}】`,
        `确定从族谱中移除「${person.name}」吗？移除后其关联的婚姻或上下代连线会自动清理。`,
        () => {
          const delId = person.id;

          // 1. 从父母的 children 列表中移除
          if (person.parentUnionId && state.unions[person.parentUnionId]) {
            const pu = state.unions[person.parentUnionId];
            pu.children = pu.children.filter(cid => cid !== delId);
            if (pu.partners.length === 0 && pu.children.length === 0) {
              delete state.unions[person.parentUnionId];
            }
          }

          // 2. 从配偶的 unions 中移除
          (person.spouseUnionIds || []).forEach(uid => {
            const u = state.unions[uid];
            if (!u) return;
            u.partners = u.partners.filter(pid => pid !== delId);
            if (u.partners.length === 0) {
              // 如果该家庭已无任何父母，解除其子女的 parentUnionId
              u.children.forEach(cid => {
                if (state.people[cid]) state.people[cid].parentUnionId = null;
              });
              delete state.unions[uid];
            }
          });

          delete state.people[delId];
          const remainingIds = Object.keys(state.people);
          state.selectedId = remainingIds[0];
          if (state.focusId === delId) state.focusId = state.selectedId;

          saveState();
          renderAll();
          showToast(`已移除节点：${person.name}`);
        }
      );
    }

