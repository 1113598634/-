    // 导出完整 PDF 族谱画卷（第1页：世系图谱画卷；第2页：世代族人名录详情）
    async function exportFamilyTreePDF() {
      const btn = document.getElementById('btnExportPdfFull');
      const originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> 正在装帧 PDF 族谱...`;

      try {
        const { canvas, layout, currentBook } = await captureFullTreeCanvas();
        const imgData = canvas.toDataURL('image/jpeg', 0.95);

        const { jsPDF } = window.jspdf;
        const pdfW = Math.max(297, Math.round((canvas.width / 2) * 0.264583));
        const pdfH = Math.max(210, Math.round((canvas.height / 2) * 0.264583));
        const orientation = pdfW >= pdfH ? 'l' : 'p';

        const pdf = new jsPDF({
          orientation,
          unit: 'mm',
          format: [pdfW, pdfH]
        });

        pdf.addImage(imgData, 'JPEG', 0, 0, pdfW, pdfH);

        // 生成第 2 页：族人世系名录详表 Canvas 并追加到 PDF
        const dirCanvas = renderDirectoryCanvasPage(currentBook, layout);
        const dirImgData = dirCanvas.toDataURL('image/jpeg', 0.95);
        const dirW = Math.round((dirCanvas.width / 2) * 0.264583);
        const dirH = Math.round((dirCanvas.height / 2) * 0.264583);

        pdf.addPage([dirW, dirH], dirW >= dirH ? 'l' : 'p');
        pdf.addImage(dirImgData, 'JPEG', 0, 0, dirW, dirH);

        pdf.save(`${currentBook.title}_源流宗谱画卷.pdf`);
        closeExportCenterModal();
        showToast('PDF 族谱画卷（含世系图与族人名录）已导出');
      } catch (err) {
        console.error('导出 PDF 失败:', err);
        showToast('导出 PDF 遇到问题，您可使用下方「浏览器矢量打印」');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }

    // 构建离屏《世系族人名录表》DOM 以供渲染进 PDF 第二页
    function buildOffscreenDirectoryDOM(currentBook, layout) {
      const wrap = document.createElement('div');
      wrap.style.position = 'fixed';
      wrap.style.left = '-10000px';
      wrap.style.top = '0';
      wrap.style.width = '1020px';
      wrap.style.backgroundColor = '#f8f5f0';
      wrap.style.padding = '36px';
      wrap.style.boxSizing = 'border-box';
      wrap.style.fontFamily = "'Inter', 'Noto Serif SC', sans-serif";

      // 按世代从第1世到第N世排序族人
      const sortedPeople = Object.values(state.people).sort((a, b) => {
        const gA = layout.genMap[a.id] || 1;
        const gB = layout.genMap[b.id] || 1;
        if (gA !== gB) return gA - gB;
        const xA = layout.nodes[a.id]?.x || 0;
        const xB = layout.nodes[b.id]?.x || 0;
        return xA - xB;
      });

      const rowsHtml = sortedPeople.map((p, i) => {
        const gen = layout.genMap[p.id] || 1;
        // 查找父母姓名
        let parentsNames = '—';
        if (p.parentUnionId && state.unions[p.parentUnionId]) {
          const pNames = state.unions[p.parentUnionId].partners
            .map(pid => state.people[pid]?.name)
            .filter(Boolean);
          if (pNames.length > 0) parentsNames = pNames.join(' 、 ');
        }
        // 查找配偶与子女姓名
        const spousesNames = [];
        const childrenNames = [];
        (p.spouseUnionIds || []).forEach(uid => {
          const u = state.unions[uid];
          if (!u) return;
          u.partners.forEach(pid => {
            if (pid !== p.id && state.people[pid]) spousesNames.push(state.people[pid].name);
          });
          u.children.forEach((cid, cIdx) => {
            const c = state.people[cid];
            if (c) childrenNames.push(`${cIdx + 1}.${c.name}`);
          });
        });

        const lifeStr = p.birthYear
          ? `${p.birthYear}年 — ${p.isAlive ? '今(健在)' : (p.deathYear ? p.deathYear + '年' : '已故')}`
          : (p.isAlive ? '健在' : '已故');

        return `
          <tr style="border-bottom: 1px solid #e2d9c8; background: ${i % 2 === 0 ? '#fdfbf7' : '#f6f1e7'};">
            <td style="padding: 10px 12px; font-weight: bold; color: #9e2a2b;">第 ${gen} 世</td>
            <td style="padding: 10px 12px; font-weight: bold; font-size: 14px; color: #2c2623; font-family: 'Noto Serif SC', serif;">${escapeHtml(p.name)}</td>
            <td style="padding: 10px 12px; color: ${p.gender === 'F' ? '#a84253' : '#2b5973'};">${p.gender === 'F' ? '女 (坤)' : '男 (乾)'}</td>
            <td style="padding: 10px 12px; color: #5c5046;">${escapeHtml(p.courtesy || '—')}</td>
            <td style="padding: 10px 12px; color: #5c5046;">${escapeHtml(lifeStr)}</td>
            <td style="padding: 10px 12px; color: #5c5046;">${escapeHtml(parentsNames)}</td>
            <td style="padding: 10px 12px; color: #5c5046;">${escapeHtml(spousesNames.join('、') || '—')}</td>
            <td style="padding: 10px 12px; color: #5c5046;">${escapeHtml(childrenNames.join('  ') || '—')}</td>
          </tr>
        `;
      }).join('');

      wrap.innerHTML = `
        <div style="border: 3px double #9e2a2b; border-radius: 12px; padding: 28px; background: #fdfbf7;">
          <div style="text-align: center; border-bottom: 2px solid #d8cfc4; padding-bottom: 16px; margin-bottom: 20px;">
            <h2 style="font-size: 22px; font-weight: bold; color: #2c2623; font-family: 'Noto Serif SC', serif; letter-spacing: 2px;">
              《${escapeHtml(currentBook.title)}》世系族人名录考略
            </h2>
            <p style="font-size: 12px; color: #7a6f64; margin-top: 6px;">
              按世代尊卑与长幼次序编列 · 记载父母渊源、配偶良缘及子嗣传承
            </p>
          </div>
          <table style="width: 100%; border-collapse: collapse; font-size: 12px; text-align: left;">
            <thead>
              <tr style="background: #efeae1; border-bottom: 2px solid #c8b9a6; color: #3d352e;">
                <th style="padding: 10px 12px;">世次</th>
                <th style="padding: 10px 12px;">姓名</th>
                <th style="padding: 10px 12px;">性别</th>
                <th style="padding: 10px 12px;">字辈 / 称谓</th>
                <th style="padding: 10px 12px;">生卒纪年</th>
                <th style="padding: 10px 12px;">父母</th>
                <th style="padding: 10px 12px;">配偶</th>
                <th style="padding: 10px 12px;">子女（按长幼排序）</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml}
            </tbody>
          </table>
        </div>
      `;
      return wrap;
    }

