    // 绘制圆角矩形辅助函数
    function drawRoundedRectPath(ctx, x, y, w, h, r) {
      const radius = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.lineTo(x + w - radius, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
      ctx.lineTo(x + w, y + h - radius);
      ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
      ctx.lineTo(x + radius, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
      ctx.lineTo(x, y + radius);
      ctx.quadraticCurveTo(x, y, x + radius, y);
      ctx.closePath();
    }

    // 文本超长省略截断辅助函数
    function fitCanvasText(ctx, text, maxWidth) {
      const str = String(text || '');
      if (ctx.measureText(str).width <= maxWidth) return str;
      let clipped = str;
      while (clipped.length > 0 && ctx.measureText(clipped + '…').width > maxWidth) {
        clipped = clipped.slice(0, -1);
      }
      return clipped + '…';
    }

    /**
     * 核心：使用原生高分屏 2D Canvas 直接绘制完整宣纸族谱画卷
     * 避免离屏 DOM 克隆或外部样式解析问题，确保 100% 稳定生成高清画卷
     */
    async function captureFullTreeCanvas() {
      // 确保当前状态含有效人物节点
      if (!state.people || Object.keys(state.people).length === 0) {
        const activeBook = library.books[library.activeBookId] || Object.values(library.books)[0];
        if (activeBook) {
          ensureValidBookData(activeBook);
          state.people = activeBook.people;
          state.unions = activeBook.unions;
          state.selectedId = activeBook.selectedId;
          state.focusId = activeBook.focusId;
          renderAll();
        }
      }

      const layout = computeFamilyTreeLayout();
      const positions = Object.values(layout.nodes);
      if (positions.length === 0) {
        throw new Error('当前族谱暂无可导出的人物节点');
      }

      const currentBook = library.books[library.activeBookId] || { title: '源流宗谱', subtitle: '慎终追远 · 世系长卷' };

      // 计算画卷逻辑边界
      const minX = Math.min(...positions.map(p => p.x)) - LAYOUT_CFG.cardW / 2 - 110;
      const maxX = Math.max(...positions.map(p => p.x)) + LAYOUT_CFG.cardW / 2 + 110;
      const maxY = Math.max(...positions.map(p => p.y)) + LAYOUT_CFG.cardH / 2 + 65;

      const outerPad = 28;
      const headerH = 104;
      const treeContentW = Math.max(960, maxX - minX);
      const treeContentH = Math.max(320, maxY + 30);

      const logicalW = treeContentW + outerPad * 2;
      const logicalH = outerPad * 2 + headerH + treeContentH;
      const scale = 2; // 2倍超清渲染

      const canvas = document.createElement('canvas');
      canvas.width = Math.round(logicalW * scale);
      canvas.height = Math.round(logicalH * scale);
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);

      // 1. 宣纸背景与微纹理点阵
      ctx.fillStyle = '#f8f5f0';
      ctx.fillRect(0, 0, logicalW, logicalH);

      ctx.fillStyle = '#e5dec9';
      for (let gx = 16; gx < logicalW; gx += 28) {
        for (let gy = 16; gy < logicalH; gy += 28) {
          ctx.fillRect(gx, gy, 1.2, 1.2);
        }
      }

      // 2. 外层新中式朱砂双线装裱边框
      const boxX = outerPad;
      const boxY = outerPad;
      const boxW = logicalW - outerPad * 2;
      const boxH = logicalH - outerPad * 2;

      drawRoundedRectPath(ctx, boxX, boxY, boxW, boxH, 12);
      ctx.fillStyle = '#f8f5f0';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#9e2a2b';
      ctx.stroke();

      drawRoundedRectPath(ctx, boxX + 5, boxY + 5, boxW - 10, boxH - 10, 9);
      ctx.lineWidth = 1;
      ctx.strokeStyle = '#c89b9b';
      ctx.stroke();

      // 3. 卷首题跋横幅区
      ctx.save();
      drawRoundedRectPath(ctx, boxX + 2, boxY + 2, boxW - 4, headerH, 10);
      ctx.clip();
      ctx.fillStyle = '#efeae1';
      ctx.fillRect(boxX, boxY, boxW, headerH);
      ctx.restore();

      ctx.beginPath();
      ctx.moveTo(boxX + 2, boxY + headerH);
      ctx.lineTo(boxX + boxW - 2, boxY + headerH);
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#d8cfc4';
      ctx.stroke();

      // 卷首左侧「谱」字印章
      const sealX = boxX + 28;
      const sealY = boxY + 24;
      drawRoundedRectPath(ctx, sealX, sealY, 56, 56, 10);
      ctx.fillStyle = '#9e2a2b';
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 28px "Noto Serif SC", "Songti SC", serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('谱', sealX + 28, sealY + 29);

      // 卷首谱名与堂号副标题
      ctx.textAlign = 'left';
      ctx.fillStyle = '#2c2623';
      ctx.font = 'bold 24px "Noto Serif SC", "Songti SC", serif';
      ctx.fillText(currentBook.title || '源流宗谱', sealX + 72, boxY + 42);

      ctx.fillStyle = '#7a6f64';
      ctx.font = '13px "Inter", "PingFang SC", sans-serif';
      ctx.fillText(currentBook.subtitle || '慎终追远 · 民德归厚 · 源流世系图卷', sealX + 72, boxY + 70);

      // 卷首右侧统计与修谱日期
      const dateStr = new Date().toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
      const totalMembers = Object.keys(state.people).length;
      ctx.textAlign = 'right';
      ctx.fillStyle = '#5c5046';
      ctx.font = 'bold 13px "Inter", "PingFang SC", sans-serif';
      ctx.fillText(`入谱宗亲：${totalMembers} 人   |   绵延世代：第 1 世 至 第 ${layout.maxGen} 世`, boxX + boxW - 28, boxY + 42);
      ctx.font = '12px "Inter", "PingFang SC", sans-serif';
      ctx.fillStyle = '#7a6f64';
      ctx.fillText(`修谱奉祀日期：${dateStr}`, boxX + boxW - 28, boxY + 68);

      // 坐标系偏移：将树图居中绘制在画卷主区域
      const treeOriginX = boxX + (boxW - (maxX - minX)) / 2 - minX;
      const treeOriginY = boxY + headerH + 18;

      ctx.save();
      ctx.translate(treeOriginX, treeOriginY);

      // 4. 绘制各世代背景横栏与竖排世代牌
      const cnGenNums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一', '十二'];
      const bandLeft = minX + 24;
      const bandWidth = (maxX - minX) - 48;

      for (let g = 1; g <= layout.maxGen; g++) {
        const centerY = (g - 1) * LAYOUT_CFG.genGapY + 90;
        const topY = centerY - LAYOUT_CFG.genGapY / 2 + 12;
        const bandH = LAYOUT_CFG.genGapY - 24;

        drawRoundedRectPath(ctx, bandLeft, topY, bandWidth, bandH, 14);
        ctx.fillStyle = 'rgba(239, 234, 225, 0.45)';
        ctx.fill();
        ctx.lineWidth = 1;
        ctx.strokeStyle = '#e3d9c8';
        ctx.stroke();

        // 左侧世代印记牌
        const tagX = bandLeft + 14;
        const tagY = centerY - 38;
        drawRoundedRectPath(ctx, tagX, tagY, 28, 76, 7);
        ctx.fillStyle = '#e5dec9';
        ctx.fill();
        ctx.strokeStyle = '#d4c8b4';
        ctx.stroke();

        const genLabel = cnGenNums[g - 1] ? `第${cnGenNums[g - 1]}世` : `第${g}世`;
        ctx.fillStyle = '#5c5046';
        ctx.font = 'bold 12px "Noto Serif SC", serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        const chars = genLabel.split('');
        chars.forEach((ch, idx) => {
          const cy = tagY + 18 + idx * 20;
          ctx.fillText(ch, tagX + 14, cy);
        });
      }

      // 5. 绘制夫妻婚姻红线与父母子女世系折线
      Object.values(state.unions).forEach(u => {
        const partners = (u.partners || []).filter(pid => layout.nodes[pid]);
        const children = (u.children || []).filter(cid => layout.nodes[cid]);

        if (partners.length >= 2) {
          const sortedP = [...partners].sort((a, b) => layout.nodes[a].x - layout.nodes[b].x);
          const leftP = layout.nodes[sortedP[0]];
          const rightP = layout.nodes[sortedP[sortedP.length - 1]];

          ctx.save();
          ctx.beginPath();
          ctx.setLineDash([5, 3]);
          ctx.moveTo(leftP.x, leftP.y);
          ctx.lineTo(rightP.x, rightP.y);
          ctx.lineWidth = 2.5;
          ctx.strokeStyle = '#c94a4a';
          ctx.stroke();
          ctx.restore();

          const midX = (leftP.x + rightP.x) / 2;
          const midY = (leftP.y + rightP.y) / 2;
          ctx.beginPath();
          ctx.arc(midX, midY, 6.5, 0, Math.PI * 2);
          ctx.fillStyle = '#fdfbf7';
          ctx.fill();
          ctx.lineWidth = 2;
          ctx.strokeStyle = '#c94a4a';
          ctx.stroke();
        }

        if (children.length > 0 && partners.length > 0) {
          const sortedP = [...partners].sort((a, b) => layout.nodes[a].x - layout.nodes[b].x);
          const parentMidX = (layout.nodes[sortedP[0]].x + layout.nodes[sortedP[sortedP.length - 1]].x) / 2;
          const parentY = layout.nodes[sortedP[0]].y;

          const startY = partners.length >= 2 ? parentY : parentY + LAYOUT_CFG.cardH / 2;
          const firstChildY = layout.nodes[children[0]].y - LAYOUT_CFG.cardH / 2;
          const busY = parentY + (firstChildY - parentY) * 0.58;

          ctx.strokeStyle = '#6e6259';
          ctx.lineWidth = 2;

          // 父母向下垂直干线
          ctx.beginPath();
          ctx.moveTo(parentMidX, startY);
          ctx.lineTo(parentMidX, busY);
          ctx.stroke();

          // 横向汇流母线
          const childXs = children.map(cid => layout.nodes[cid].x);
          const minChildX = Math.min(parentMidX, ...childXs);
          const maxChildX = Math.max(parentMidX, ...childXs);
          if (maxChildX > minChildX) {
            ctx.beginPath();
            ctx.moveTo(minChildX, busY);
            ctx.lineTo(maxChildX, busY);
            ctx.stroke();
          }

          // 各子女垂直分支线与圆点
          children.forEach(cid => {
            const cPos = layout.nodes[cid];
            const childTopY = cPos.y - LAYOUT_CFG.cardH / 2;
            ctx.beginPath();
            ctx.moveTo(cPos.x, busY);
            ctx.lineTo(cPos.x, childTopY);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(cPos.x, childTopY, 3, 0, Math.PI * 2);
            ctx.fillStyle = '#6e6259';
            ctx.fill();
          });
        }
      });

      // 6. 绘制每一位族人卡片节点
      Object.keys(state.people).forEach(pid => {
        const person = state.people[pid];
        const pos = layout.nodes[pid];
        if (!pos) return;

        const cardX = pos.x - LAYOUT_CFG.cardW / 2;
        const cardY = pos.y - LAYOUT_CFG.cardH / 2;
        const isFemale = person.gender === 'F';

        // 卡片阴影与主体底色
        ctx.save();
        ctx.shadowColor = 'rgba(44, 38, 35, 0.10)';
        ctx.shadowBlur = 10;
        ctx.shadowOffsetY = 3;
        drawRoundedRectPath(ctx, cardX, cardY, LAYOUT_CFG.cardW, LAYOUT_CFG.cardH, 11);
        ctx.fillStyle = '#fdfbf7';
        ctx.fill();
        ctx.restore();

        // 顶部乾坤性别色带
        ctx.save();
        drawRoundedRectPath(ctx, cardX, cardY, LAYOUT_CFG.cardW, LAYOUT_CFG.cardH, 11);
        ctx.clip();
        ctx.fillStyle = isFemale ? '#a84253' : '#2b5973';
        ctx.fillRect(cardX, cardY, LAYOUT_CFG.cardW, 6);
        ctx.restore();

        // 卡片外边框
        drawRoundedRectPath(ctx, cardX, cardY, LAYOUT_CFG.cardW, LAYOUT_CFG.cardH, 11);
        ctx.lineWidth = 1.8;
        ctx.strokeStyle = isFemale ? '#d6a2ad' : '#9ab3c2';
        ctx.stroke();

        // 头像徽标方块
        const avX = cardX + 10;
        const avY = cardY + 14;
        drawRoundedRectPath(ctx, avX, avY, 32, 32, 7);
        ctx.fillStyle = isFemale ? '#f7e8eb' : '#e6eff5';
        ctx.fill();

        const firstChar = person.name ? person.name.trim().slice(-1) : '族';
        ctx.fillStyle = isFemale ? '#a84253' : '#2b5973';
        ctx.font = 'bold 14px "Noto Serif SC", serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(firstChar, avX + 16, avY + 16.5);

        // 姓名与字辈/世次
        ctx.textAlign = 'left';
        ctx.fillStyle = '#2c2623';
        ctx.font = 'bold 14px "Noto Serif SC", serif';
        ctx.fillText(fitCanvasText(ctx, person.name, 88), avX + 40, avY + 10);

        ctx.fillStyle = '#7a6f64';
        ctx.font = '10px "Inter", "PingFang SC", sans-serif';
        const subText = person.courtesy || `第 ${pos.gen} 世`;
        ctx.fillText(fitCanvasText(ctx, subText, 88), avX + 40, avY + 25);

        // 底部分割线
        const divY = cardY + LAYOUT_CFG.cardH - 24;
        ctx.beginPath();
        ctx.moveTo(cardX + 10, divY);
        ctx.lineTo(cardX + LAYOUT_CFG.cardW - 10, divY);
        ctx.lineWidth = 1;
        ctx.strokeStyle = '#efeae1';
        ctx.stroke();

        // 生卒年份
        const yearDisplay = person.birthYear
          ? `${person.birthYear}${!person.isAlive && person.deathYear ? ' - ' + person.deathYear : ' - 今'}`
          : (person.isAlive ? '健在' : '已故');
        ctx.fillStyle = '#8c7d70';
        ctx.font = '10px "Inter", "PingFang SC", sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(yearDisplay, cardX + 10, cardY + LAYOUT_CFG.cardH - 11);

        // 同胞长幼排行角标
        if (person.parentUnionId && state.unions[person.parentUnionId]) {
          const siblings = state.unions[person.parentUnionId].children || [];
          const idx = siblings.indexOf(pid);
          if (idx !== -1) {
            const rankLabel = getRankLabel(idx, person.gender, siblings.length);
            const tagW = Math.max(28, ctx.measureText(rankLabel).width + 10);
            const tagH = 15;
            const rX = cardX + LAYOUT_CFG.cardW - 10 - tagW;
            const rY = cardY + LAYOUT_CFG.cardH - 19;

            drawRoundedRectPath(ctx, rX, rY, tagW, tagH, 4);
            ctx.fillStyle = '#efeae1';
            ctx.fill();
            ctx.lineWidth = 0.8;
            ctx.strokeStyle = '#dcd3c6';
            ctx.stroke();

            ctx.fillStyle = '#5c5046';
            ctx.font = 'bold 9.5px "Inter", "PingFang SC", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(rankLabel, rX + tagW / 2, rY + tagH / 2 + 0.5);
          }
        }
      });

      ctx.restore();
      return { canvas, layout, currentBook };
    }

    /**
     * 使用原生 2D Canvas 直接渲染《世系族人名录考略》表格页，用于 PDF 第二页
     */
    function renderDirectoryCanvasPage(currentBook, layout) {
      const sortedPeople = Object.values(state.people).sort((a, b) => {
        const gA = layout.genMap[a.id] || 1;
        const gB = layout.genMap[b.id] || 1;
        if (gA !== gB) return gA - gB;
        const xA = layout.nodes[a.id]?.x || 0;
        const xB = layout.nodes[b.id]?.x || 0;
        return xA - xB;
      });

      const pageW = 1060;
      const rowH = 38;
      const headerAreaH = 135;
      const tableHeaderH = 40;
      const outerPad = 32;
      const pageH = Math.max(520, outerPad * 2 + headerAreaH + tableHeaderH + sortedPeople.length * rowH + 40);
      const scale = 2;

      const canvas = document.createElement('canvas');
      canvas.width = pageW * scale;
      canvas.height = pageH * scale;
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);

      // 背景与双线边框
      ctx.fillStyle = '#f8f5f0';
      ctx.fillRect(0, 0, pageW, pageH);

      const boxX = outerPad;
      const boxY = outerPad;
      const boxW = pageW - outerPad * 2;
      const boxH = pageH - outerPad * 2;

      drawRoundedRectPath(ctx, boxX, boxY, boxW, boxH, 12);
      ctx.fillStyle = '#fdfbf7';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = '#9e2a2b';
      ctx.stroke();

      // 标题区
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#2c2623';
      ctx.font = 'bold 22px "Noto Serif SC", serif';
      ctx.fillText(`《${currentBook.title || '源流宗谱'}》世系族人名录考略`, pageW / 2, boxY + 46);

      ctx.fillStyle = '#7a6f64';
      ctx.font = '12px "Inter", "PingFang SC", sans-serif';
      ctx.fillText('按世代尊卑与长幼次序编列 · 记载父母渊源、配偶良缘及子嗣传承', pageW / 2, boxY + 76);

      ctx.beginPath();
      ctx.moveTo(boxX + 24, boxY + 102);
      ctx.lineTo(boxX + boxW - 24, boxY + 102);
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#d8cfc4';
      ctx.stroke();

      // 表格列定义
      const tableX = boxX + 24;
      const tableY = boxY + 120;
      const tableW = boxW - 48;
      const cols = [
        { title: '世次', width: 70 },
        { title: '姓名', width: 105 },
        { title: '性别', width: 70 },
        { title: '字辈 / 称谓', width: 145 },
        { title: '生卒纪年', width: 135 },
        { title: '父母', width: 130 },
        { title: '配偶', width: 115 },
        { title: '子女（按长幼排序）', width: 178 }
      ];

      // 绘制表头
      ctx.fillStyle = '#efeae1';
      ctx.fillRect(tableX, tableY, tableW, tableHeaderH);
      ctx.beginPath();
      ctx.moveTo(tableX, tableY + tableHeaderH);
      ctx.lineTo(tableX + tableW, tableY + tableHeaderH);
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = '#c8b9a6';
      ctx.stroke();

      ctx.textAlign = 'left';
      ctx.fillStyle = '#3d352e';
      ctx.font = 'bold 12px "Inter", "PingFang SC", sans-serif';
      let colCursor = tableX;
      cols.forEach(c => {
        ctx.fillText(c.title, colCursor + 10, tableY + tableHeaderH / 2);
        colCursor += c.width;
      });

      // 绘制每一行族人档案
      sortedPeople.forEach((p, idx) => {
        const rY = tableY + tableHeaderH + idx * rowH;
        ctx.fillStyle = idx % 2 === 0 ? '#fdfbf7' : '#f6f1e7';
        ctx.fillRect(tableX, rY, tableW, rowH);

        ctx.beginPath();
        ctx.moveTo(tableX, rY + rowH);
        ctx.lineTo(tableX + tableW, rY + rowH);
        ctx.lineWidth = 1;
        ctx.strokeStyle = '#e2d9c8';
        ctx.stroke();

        const gen = layout.genMap[p.id] || 1;
        let parentsNames = '—';
        if (p.parentUnionId && state.unions[p.parentUnionId]) {
          const pNames = state.unions[p.parentUnionId].partners
            .map(pid => state.people[pid]?.name)
            .filter(Boolean);
          if (pNames.length > 0) parentsNames = pNames.join('、');
        }

        const spousesNames = [];
        const childrenNames = [];
        (p.spouseUnionIds || []).forEach(uid => {
          const u = state.unions[uid];
          if (!u) return;
          u.partners.forEach(pid => {
            if (pid !== p.id && state.people[pid]) spousesNames.push(state.people[pid].name);
          });
          u.children.forEach((cid, cIdx) => {
            const c = state.people[cid];
            if (c) childrenNames.push(`${cIdx + 1}.${c.name}`);
          });
        });

        const lifeStr = p.birthYear
          ? `${p.birthYear}年—${p.isAlive ? '今' : (p.deathYear ? p.deathYear + '年' : '已故')}`
          : (p.isAlive ? '健在' : '已故');

        const rowValues = [
          { text: `第 ${gen} 世`, color: '#9e2a2b', bold: true },
          { text: p.name || '—', color: '#2c2623', bold: true },
          { text: p.gender === 'F' ? '女 (坤)' : '男 (乾)', color: p.gender === 'F' ? '#a84253' : '#2b5973' },
          { text: p.courtesy || '—', color: '#5c5046' },
          { text: lifeStr, color: '#5c5046' },
          { text: parentsNames, color: '#5c5046' },
          { text: spousesNames.join('、') || '—', color: '#5c5046' },
          { text: childrenNames.join(' ') || '—', color: '#5c5046' }
        ];

        let cellX = tableX;
        rowValues.forEach((cell, cIdx) => {
          const maxW = cols[cIdx].width - 16;
          ctx.fillStyle = cell.color;
          ctx.font = `${cell.bold ? 'bold ' : ''}12px "Inter", "PingFang SC", sans-serif`;
          ctx.fillText(fitCanvasText(ctx, cell.text, maxW), cellX + 10, rY + rowH / 2);
          cellX += cols[cIdx].width;
        });
      });

      return canvas;
    }

