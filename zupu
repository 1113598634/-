    /* ==================== 多族谱管理中心逻辑 (新建 / 切换 / 重命名 / 删除) ==================== */

    function openClanManagerModal() {
      renderClanBooksList();
      const modal = document.getElementById('clanManagerModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeClanManagerModal() {
      const modal = document.getElementById('clanManagerModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function renderClanBooksList() {
      const container = document.getElementById('clanBooksListContainer');
      const bookIds = Object.keys(library.books);
      document.getElementById('totalBooksCount').textContent = bookIds.length;
      container.innerHTML = '';

      // 按最近修改时间排序
      const sortedBooks = bookIds
        .map(id => library.books[id])
        .sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));

      sortedBooks.forEach(book => {
        const isCurrent = book.id === library.activeBookId;
        const memberCount = book.people ? Object.keys(book.people).length : 0;
        const dateStr = book.updatedAt ? new Date(book.updatedAt).toLocaleString('zh-CN', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '刚刚';

        const card = document.createElement('div');
        card.className = `p-3.5 rounded-xl border transition flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ${
          isCurrent ? 'bg-[#fff9f8] border-2 border-[#9e2a2b] shadow-xs' : 'bg-white border-[#dcd3c6] hover:border-[#b5a899]'
        }`;

        card.innerHTML = `
          <div class="flex items-start gap-3 min-w-0 flex-1 cursor-pointer" onclick="switchClanBook('${book.id}')">
            <div class="w-10 h-10 rounded-xl ${isCurrent ? 'bg-[#9e2a2b] text-white' : 'bg-[#efeae1] text-[#5c5046]'} flex items-center justify-center font-bold serif-title text-base shrink-0 mt-0.5">
              ${escapeHtml(book.title ? book.title.charAt(0) : '谱')}
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h4 class="serif-title font-bold text-sm text-[#2c2623] truncate">${escapeHtml(book.title)}</h4>
                ${isCurrent ? '<span class="px-2 py-0.5 rounded-full bg-[#9e2a2b] text-white text-[10px] font-medium">当前打开</span>' : ''}
                <span class="px-2 py-0.5 rounded-full bg-[#efeae1] text-[#5c5046] text-[10px]">共 ${memberCount} 人</span>
              </div>
              <p class="text-xs text-[#7a6f64] truncate mt-0.5">${escapeHtml(book.subtitle || '暂无堂号或字辈备注')}</p>
              <div class="text-[10px] text-[#9c8f82] mt-1">最后修订：${dateStr}</div>
            </div>
          </div>

          <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-center">
            ${!isCurrent ? `
              <button onclick="switchClanBook('${book.id}')" class="px-3 py-1.5 rounded-lg bg-[#2b5973] hover:bg-[#1f4357] text-white text-xs font-medium transition">
                切换打开
              </button>
            ` : ''}
            <button onclick="openEditClanMetaModal('${book.id}')" class="px-2.5 py-1.5 rounded-lg bg-[#f8f5f0] hover:bg-[#efeae1] text-[#5c5046] border border-[#dcd3c6] text-xs transition" title="重命名族谱或修改字辈">
              <i class="fa-regular fa-pen-to-square"></i> 编辑谱名
            </button>
            <button onclick="deleteClanBook('${book.id}')" class="px-2.5 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs transition" title="删除此部族谱">
              <i class="fa-regular fa-trash-can"></i> 删除
            </button>
          </div>
        `;
        container.appendChild(card);
      });
    }

