    // 提交新建或重命名族谱表单
    function submitClanBookForm(e) {
      e.preventDefault();
      const editingId = document.getElementById('editingBookId').value;
      const title = document.getElementById('bookTitleInput').value.trim();
      const subtitle = document.getElementById('bookSubtitleInput').value.trim();

      if (!title) return;

      if (editingId && library.books[editingId]) {
        // 修改已有族谱元信息
        library.books[editingId].title = title;
        library.books[editingId].subtitle = subtitle;
        library.books[editingId].updatedAt = Date.now();
        saveState();
        if (library.activeBookId === editingId) {
          document.getElementById('currentBookTitleDisplay').textContent = title;
          document.getElementById('currentBookNoteDisplay').textContent = subtitle || '点击人物卡片添加血亲姻亲 · 拖拽调整长幼排行';
        }
        renderClanBooksList();
        closeNewClanModal();
        showToast(`已更新谱名：《${title}》`);
      } else {
        // 创建新族谱
        const founderName = document.getElementById('founderNameInput').value.trim() || '林怀远';
        const founderGender = document.getElementById('founderGenderInput').value;
        const founderYear = document.getElementById('founderYearInput').value.trim();
        const founderCourtesy = document.getElementById('founderCourtesyInput').value.trim();

        const newBookId = generateId('book');
        const newBook = buildSingleFounderBookObject(
          newBookId,
          title,
          subtitle,
          founderName,
          founderGender,
          founderYear,
          founderCourtesy
        );

        library.books[newBookId] = newBook;
        activateClanBook(newBookId, true);
        renderClanBooksList();
        closeNewClanModal();
        closeClanManagerModal();
        showToast(`已创建新族谱《${title}》，始祖：${founderName}`);
      }
    }

    // 删除指定族谱
    function deleteClanBook(bookId) {
      const book = library.books[bookId];
      if (!book) return;

      const allBookIds = Object.keys(library.books);

      showConfirmDialog(
        `删除族谱《${book.title}》`,
        allBookIds.length <= 1
          ? `《${book.title}》是当前最后一部族谱。删除后系统将自动为您创建一个全新的空白族谱，确定删除吗？`
          : `确定永久删除《${book.title}》及其包含的 ${Object.keys(book.people || {}).length} 位族人数据吗？此操作不可撤销。`,
        () => {
          delete library.books[bookId];
          const remainingIds = Object.keys(library.books);

          if (remainingIds.length === 0) {
            const freshId = generateId('book');
            library.books[freshId] = buildSingleFounderBookObject(
              freshId,
              '新修宗谱',
              '源远流长 · 世系大典',
              '林怀远',
              'M',
              1965,
              '一世始祖'
            );
            activateClanBook(freshId, true);
          } else if (library.activeBookId === bookId) {
            activateClanBook(remainingIds[0], true);
          } else {
            saveState();
          }

          renderClanBooksList();
          showToast(`已删除族谱《${book.title}》`);
        }
      );
    }

    /* ==================== 核心亲属添加逻辑 ==================== */

    // 打开快捷添加弹窗
    function openQuickAddModal(mode) {
      const current = state.people[state.selectedId];
      if (!current) return;

      document.getElementById('quickAddMode').value = mode;
      const modal = document.getElementById('addRelativeModal');
      const titleEl = document.getElementById('modalTitle');
      const subEl = document.getElementById('modalSubtitle');
      const parentsDual = document.getElementById('parentsDualInputs');
      const singleInputs = document.getElementById('singleRelativeInputs');
      const childUnionWrap = document.getElementById('childParentUnionWrap');
      const insertPosWrap = document.getElementById('insertPositionWrap');

      // 重置输入框
      document.getElementById('quickAddForm').reset();
      parentsDual.classList.add('hidden');
      singleInputs.classList.remove('hidden');
      childUnionWrap.classList.add('hidden');
      insertPosWrap.classList.add('hidden');

      const familySurname = current.name ? current.name.charAt(0) : '';

      if (mode === 'parents') {
        // 检查是否已有父母完整节点
        if (current.parentUnionId) {
          const pUnion = state.unions[current.parentUnionId];
          if (pUnion && pUnion.partners && pUnion.partners.length >= 2) {
            showToast('该人物已有父母节点，可直接点击其父母卡片编辑');
            return;
          }
        }
        parentsDual.classList.remove('hidden');
        singleInputs.classList.add('hidden');
        titleEl.textContent = `为【${current.name}】添加父母`;
        subEl.innerHTML = `将在 <strong>${current.name}</strong> 的上一世代创建父亲与母亲节点，并自动建立父子/母子世系连接。`;
        document.getElementById('addFatherName').value = familySurname;
        if (current.birthYear) {
          document.getElementById('addFatherYear').value = Number(current.birthYear) - 26;
          document.getElementById('addMotherYear').value = Number(current.birthYear) - 24;
        }
      } 
      else if (mode === 'spouse') {
        titleEl.textContent = `为【${current.name}】添加配偶`;
        subEl.innerHTML = `配偶将与 <strong>${current.name}</strong> 同代并排展示，并以朱砂婚姻连线相系。`;
        document.getElementById('addSingleGender').value = current.gender === 'M' ? 'F' : 'M';
        if (current.birthYear) {
          document.getElementById('addSingleBirthYear').value = current.birthYear;
        }
        document.getElementById('addSingleCourtesy').value = current.gender === 'M' ? '正室 / 配偶' : '夫婿 / 配偶';
      } 
      else if (mode === 'sibling') {
        titleEl.textContent = `为【${current.name}】添加同胞兄弟姐妹`;
        subEl.innerHTML = `将与 <strong>${current.name}</strong> 共享同一父母世系，支持自由选择长幼排位。`;
        insertPosWrap.classList.remove('hidden');
        document.getElementById('optBeforeCurrent').classList.remove('hidden');
        document.getElementById('optAfterCurrent').classList.remove('hidden');
        document.getElementById('insertOrderSelect').value = 'after_current';
        document.getElementById('addSingleName').value = familySurname;
        if (current.birthYear) {
          document.getElementById('addSingleBirthYear').value = Number(current.birthYear) + 2;
        }
        document.getElementById('addSingleCourtesy').value = '同胞手足';
      } 
      else if (mode === 'child') {
        titleEl.textContent = `为【${current.name}】添加子女`;
        subEl.innerHTML = `将在 <strong>${current.name}</strong> 的下一世代添加子女节点，并可在右侧面板随时调整长幼排序。`;
        insertPosWrap.classList.remove('hidden');
        document.getElementById('optBeforeCurrent').classList.add('hidden');
        document.getElementById('optAfterCurrent').classList.add('hidden');
        document.getElementById('insertOrderSelect').value = 'last';
        document.getElementById('addSingleName').value = familySurname;
        if (current.birthYear) {
          document.getElementById('addSingleBirthYear').value = Number(current.birthYear) + 25;
        }
        document.getElementById('addSingleCourtesy').value = '之子 / 之女';

        // 如果当前人物有多个婚姻单元，允许选择挂在哪个婚姻下
        if (current.spouseUnionIds && current.spouseUnionIds.length > 1) {
          childUnionWrap.classList.remove('hidden');
          const sel = document.getElementById('childUnionSelect');
          sel.innerHTML = '';
          current.spouseUnionIds.forEach((uid, idx) => {
            const u = state.unions[uid];
            const partnerNames = u.partners
              .map(pid => state.people[pid]?.name || '未知')
              .join(' & ');
            const opt = document.createElement('option');
            opt.value = uid;
            opt.textContent = `家庭 ${idx + 1}：${partnerNames}`;
            sel.appendChild(opt);
          });
        }
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeQuickAddModal() {
      const modal = document.getElementById('addRelativeModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // 提交创建亲属节点
    function submitQuickAdd(e) {
      e.preventDefault();
      const mode = document.getElementById('quickAddMode').value;
      const current = state.people[state.selectedId];
      if (!current) return;

      if (mode === 'parents') {
        const fName = document.getElementById('addFatherName').value.trim();
        const fYear = document.getElementById('addFatherYear').value.trim();
        const mName = document.getElementById('addMotherName').value.trim();
        const mYear = document.getElementById('addMotherYear').value.trim();

        if (!fName && !mName) {
          showToast('请至少填写父亲或母亲的姓名');
          return;
        }

        // 如果当前人物已有虚拟的同胞连接点 (无名父母 union)，直接把父母注入该 union
        let targetUnion = current.parentUnionId ? state.unions[current.parentUnionId] : null;
        if (!targetUnion) {
          const newUid = generateId('u');
          targetUnion = { id: newUid, partners: [], children: [current.id] };
          state.unions[newUid] = targetUnion;
          current.parentUnionId = newUid;
        }

        if (fName) {
          const fid = generateId('p');
          state.people[fid] = {
            id: fid,
            name: fName,
            gender: 'M',
            birthYear: fYear ? Number(fYear) : '',
            deathYear: '',
            isAlive: true,
            courtesy: '严父',
            bio: '',
            parentUnionId: null,
            spouseUnionIds: [targetUnion.id]
          };
          targetUnion.partners.push(fid);
        }

        if (mName) {
          const mid = generateId('p');
          state.people[mid] = {
            id: mid,
            name: mName,
            gender: 'F',
            birthYear: mYear ? Number(mYear) : '',
            deathYear: '',
            isAlive: true,
            courtesy: '慈母',
            bio: '',
            parentUnionId: null,
            spouseUnionIds: [targetUnion.id]
          };
          targetUnion.partners.push(mid);
        }

        showToast(`已为 ${current.name} 添加父母节点`);
      } 
      else if (mode === 'spouse') {
        const sName = document.getElementById('addSingleName').value.trim();
        if (!sName) return;
        const sGender = document.getElementById('addSingleGender').value;
        const sYear = document.getElementById('addSingleBirthYear').value.trim();
        const sCourtesy = document.getElementById('addSingleCourtesy').value.trim();

        const sid = generateId('p');
        state.people[sid] = {
          id: sid,
          name: sName,
          gender: sGender,
          birthYear: sYear ? Number(sYear) : '',
          deathYear: '',
          isAlive: true,
          courtesy: sCourtesy || '配偶',
          bio: '',
          parentUnionId: null,
          spouseUnionIds: []
        };

        // 如果当前人物已有一个单亲家庭（只有本人没有配偶），直接把新配偶并入该家庭
        let singleParentUnion = (current.spouseUnionIds || [])
          .map(uid => state.unions[uid])
          .find(u => u && u.partners.length === 1 && u.partners[0] === current.id);

        if (singleParentUnion) {
          singleParentUnion.partners.push(sid);
          state.people[sid].spouseUnionIds.push(singleParentUnion.id);
        } else {
          const uid = generateId('u');
          state.unions[uid] = {
            id: uid,
            partners: [current.id, sid],
            children: []
          };
          current.spouseUnionIds.push(uid);
          state.people[sid].spouseUnionIds.push(uid);
        }

        showToast(`已添加配偶：${sName}`);
      } 
      else if (mode === 'sibling') {
        const sibName = document.getElementById('addSingleName').value.trim();
        if (!sibName) return;
        const sibGender = document.getElementById('addSingleGender').value;
        const sibYear = document.getElementById('addSingleBirthYear').value.trim();
        const sibCourtesy = document.getElementById('addSingleCourtesy').value.trim();
        const insertPos = document.getElementById('insertOrderSelect').value;

        // 若当前人物尚无父母节点，自动为其生成一对默认先祖父母或共祖连接，使同胞兄弟姐妹有共同上源
        let parentUnion = current.parentUnionId ? state.unions[current.parentUnionId] : null;
        if (!parentUnion) {
          const surname = current.name ? current.name.charAt(0) : '某';
          const autoFatherId = generateId('p');
          const uid = generateId('u');
          state.people[autoFatherId] = {
            id: autoFatherId,
            name: `${surname}公 (待补全)`,
            gender: 'M',
            birthYear: current.birthYear ? Number(current.birthYear) - 26 : '',
            deathYear: '',
            isAlive: true,
            courtesy: '同胞共祖父辈',
            bio: '添加兄弟姐妹时自动生成的父辈节点，点击可修改真实姓名。',
            parentUnionId: null,
            spouseUnionIds: [uid]
          };
          parentUnion = {
            id: uid,
            partners: [autoFatherId],
            children: [current.id]
          };
          state.unions[uid] = parentUnion;
          current.parentUnionId = uid;
        }

        const newSibId = generateId('p');
        state.people[newSibId] = {
          id: newSibId,
          name: sibName,
          gender: sibGender,
          birthYear: sibYear ? Number(sibYear) : '',
          deathYear: '',
          isAlive: true,
          courtesy: sibCourtesy || '同胞',
          bio: '',
          parentUnionId: parentUnion.id,
          spouseUnionIds: []
        };

        const idx = parentUnion.children.indexOf(current.id);
        if (insertPos === 'first') {
          parentUnion.children.unshift(newSibId);
        } else if (insertPos === 'before_current' && idx !== -1) {
          parentUnion.children.splice(idx, 0, newSibId);
        } else if (insertPos === 'after_current' && idx !== -1) {
          parentUnion.children.splice(idx + 1, 0, newSibId);
        } else {
          parentUnion.children.push(newSibId);
        }

        showToast(`已添加同胞手足：${sibName}`);
      } 
      else if (mode === 'child') {
        const cName = document.getElementById('addSingleName').value.trim();
        if (!cName) return;
        const cGender = document.getElementById('addSingleGender').value;
        const cYear = document.getElementById('addSingleBirthYear').value.trim();
        const cCourtesy = document.getElementById('addSingleCourtesy').value.trim();
        const insertPos = document.getElementById('insertOrderSelect').value;

        let targetUnion = null;
        if (current.spouseUnionIds && current.spouseUnionIds.length > 1) {
          const chosenUid = document.getElementById('childUnionSelect').value;
          targetUnion = state.unions[chosenUid];
        } else if (current.spouseUnionIds && current.spouseUnionIds.length === 1) {
          targetUnion = state.unions[current.spouseUnionIds[0]];
        }

        // 如果当前人物还没有配偶 union，创建一个单亲家庭 union
        if (!targetUnion) {
          const uid = generateId('u');
          targetUnion = {
            id: uid,
            partners: [current.id],
            children: []
          };
          state.unions[uid] = targetUnion;
          current.spouseUnionIds.push(uid);
        }

        const cid = generateId('p');
        state.people[cid] = {
          id: cid,
          name: cName,
          gender: cGender,
          birthYear: cYear ? Number(cYear) : '',
          deathYear: '',
          isAlive: true,
          courtesy: cCourtesy || (cGender === 'M' ? '之子' : '之女'),
          bio: '',
          parentUnionId: targetUnion.id,
          spouseUnionIds: []
        };

        if (insertPos === 'first') {
          targetUnion.children.unshift(cid);
        } else {
          targetUnion.children.push(cid);
        }

        showToast(`已添加子女：${cName}`);
      }

      closeQuickAddModal();
      saveState();
      renderAll();
    }

    /* ==================== 子女排序与排行管理 ==================== */

    // 获取当前选中人物用于展示子女列表的家庭 Union
    function getActiveUnionForSelected() {
      const person = state.people[state.selectedId];
      if (!person || !person.spouseUnionIds || person.spouseUnionIds.length === 0) return null;

      const selectEl = document.getElementById('unionSelect');
      if (person.spouseUnionIds.length > 1 && selectEl && selectEl.value && state.unions[selectEl.value]) {
        return state.unions[selectEl.value];
      }
      return state.unions[person.spouseUnionIds[0]] || null;
    }

    // 根据排行索引和性别生成传统长幼称谓标签
    function getRankLabel(index, gender, total) {
      const cnNums = ['长', '次', '三', '四', '五', '六', '七', '八', '九', '十'];
      const prefix = index < cnNums.length ? cnNums[index] : `第${index + 1}`;
      const suffix = gender === 'F' ? '女' : '子';
      return `${prefix}${suffix}`;
    }

    // 渲染右侧面板的子女排序列表（支持拖拽 + 上移/下移 + 一键按生年排）
    let draggedChildIndex = null;

    function renderChildrenSortList() {
      const person = state.people[state.selectedId];
      const listContainer = document.getElementById('childrenSortList');
      const unionWrap = document.getElementById('unionSelectorWrap');
      const unionSelect = document.getElementById('unionSelect');
      const siblingTip = document.getElementById('siblingOrderTip');

      if (!person) return;

      // 判断是否显示“切换到父母节点排本人与兄弟姐妹”的提示
      if (person.parentUnionId && state.unions[person.parentUnionId]?.children?.length > 1) {
        siblingTip.classList.remove('hidden');
      } else {
        siblingTip.classList.add('hidden');
      }

      // 多配偶家庭下拉框
      if (person.spouseUnionIds && person.spouseUnionIds.length > 1) {
        unionWrap.classList.remove('hidden');
        const currentVal = unionSelect.value;
        unionSelect.innerHTML = '';
        person.spouseUnionIds.forEach((uid, i) => {
          const u = state.unions[uid];
          if (!u) return;
          const names = u.partners.map(pid => state.people[pid]?.name || '').join(' & ');
          const opt = document.createElement('option');
          opt.value = uid;
          opt.textContent = `婚姻 ${i + 1} (${names})`;
          unionSelect.appendChild(opt);
        });
        if (person.spouseUnionIds.includes(currentVal)) {
          unionSelect.value = currentVal;
        }
      } else {
        unionWrap.classList.add('hidden');
      }

      const activeUnion = getActiveUnionForSelected();
      const childrenIds = activeUnion ? activeUnion.children.filter(cid => state.people[cid]) : [];

      listContainer.innerHTML = '';

      if (childrenIds.length === 0) {
        listContainer.innerHTML = `
          <div class="py-5 text-center text-xs text-[#9c8f82] bg-[#f8f5f0] rounded-lg border border-dashed border-[#dcd3c6]">
            暂无子女节点，点击上方「添加子女」繁衍后代
          </div>
        `;
        return;
      }

      childrenIds.forEach((cid, idx) => {
        const child = state.people[cid];
        const rankText = getRankLabel(idx, child.gender, childrenIds.length);
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-2 rounded-lg bg-[#f8f5f0] hover:bg-[#efeae1] border border-[#e5dec9] transition cursor-move';
        item.draggable = true;

        // 拖拽排序事件
        item.addEventListener('dragstart', () => {
          draggedChildIndex = idx;
          item.classList.add('dragging-item');
        });
        item.addEventListener('dragend', () => {
          item.classList.remove('dragging-item');
          draggedChildIndex = null;
        });
        item.addEventListener('dragover', (ev) => {
          ev.preventDefault();
        });
        item.addEventListener('drop', (ev) => {
          ev.preventDefault();
          if (draggedChildIndex === null || draggedChildIndex === idx) return;
          reorderChild(activeUnion.id, draggedChildIndex, idx);
        });

        const genderBadgeClass = child.gender === 'F' ? 'bg-[#a84253]' : 'bg-[#2b5973]';

        item.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            <i class="fa-solid fa-grip-vertical text-[#b5a899] text-xs px-1"></i>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded text-white ${genderBadgeClass}">
              ${rankText}
            </span>
            <button type="button" onclick="selectPerson('${child.id}')" class="text-xs font-semibold text-[#2c2623] hover:text-[#9e2a2b] truncate text-left">
              ${escapeHtml(child.name)}
            </button>
            <span class="text-[11px] text-[#8c7d70] shrink-0">
              ${child.birthYear ? child.birthYear + '年' : ''}
            </span>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" onclick="moveChildStep('${activeUnion.id}', ${idx}, -1)" 
              ${idx === 0 ? 'disabled' : ''}
              class="w-6 h-6 rounded hover:bg-white text-[#5c5046] disabled:opacity-30 flex items-center justify-center border border-transparent hover:border-[#d8cfc4]" title="上移（排行靠前/靠左）">
              <i class="fa-solid fa-arrow-up text-[10px]"></i>
            </button>
            <button type="button" onclick="moveChildStep('${activeUnion.id}', ${idx}, 1)" 
              ${idx === childrenIds.length - 1 ? 'disabled' : ''}
              class="w-6 h-6 rounded hover:bg-white text-[#5c5046] disabled:opacity-30 flex items-center justify-center border border-transparent hover:border-[#d8cfc4]" title="下移（排行靠后/靠右）">
              <i class="fa-solid fa-arrow-down text-[10px]"></i>
            </button>
          </div>
        `;
        listContainer.appendChild(item);
      });
    }

    // 上移/下移子女顺序
    function moveChildStep(unionId, currentIndex, delta) {
      const targetIndex = currentIndex + delta;
      reorderChild(unionId, currentIndex, targetIndex);
    }

    // 执行子女数组位置互换并实时重绘树图
    function reorderChild(unionId, fromIndex, toIndex) {
      const u = state.unions[unionId];
      if (!u || !u.children) return;
      if (toIndex < 0 || toIndex >= u.children.length) return;

      const moved = u.children.splice(fromIndex, 1)[0];
      u.children.splice(toIndex, 0, moved);

      saveState();
      renderAll();
      showToast('已更新子女长幼排行顺序');
    }

    // 按出生年份自动对当前人物的子女排序
    function sortCurrentChildrenByBirthYear() {
      const activeUnion = getActiveUnionForSelected();
      if (!activeUnion || !activeUnion.children || activeUnion.children.length < 2) {
        showToast('需要至少 2 名子女才可排序');
        return;
      }

      activeUnion.children.sort((aId, bId) => {
        const a = state.people[aId];
        const b = state.people[bId];
        const yA = a && a.birthYear ? Number(a.birthYear) : 99999;
        const yB = b && b.birthYear ? Number(b.birthYear) : 99999;
        return yA - yB;
      });

      saveState();
      renderAll();
      showToast('已按出生年份从早到晚自动排定子女次序');
    }

    // 快捷跳转至父母节点以调整本人与同胞兄弟姐妹的顺序
    function selectParentToReorderSiblings() {
      const current = state.people[state.selectedId];
      if (!current || !current.parentUnionId) return;
      const pUnion = state.unions[current.parentUnionId];
      if (pUnion && pUnion.partners && pUnion.partners.length > 0) {
        selectPerson(pUnion.partners[0]);
        centerViewOnSelected();
        showToast('已切换至父辈节点，可在右侧调整同胞排行');
      }
    }

    /* ==================== 树状层次与坐标自动布局算法 ==================== */

    function computeFamilyTreeLayout() {
      const peopleIds = Object.keys(state.people);
      if (peopleIds.length === 0) return { nodes: {}, unions: {}, genMap: {}, minGen: 1, maxGen: 1 };

      // 1. 通过 BFS 计算每个人相对于先祖的世代层级 (Generation Level)
      const genMap = {};
      const visited = new Set();

      peopleIds.forEach(startId => {
        if (visited.has(startId)) return;
        genMap[startId] = 0;
        visited.add(startId);
        const queue = [startId];

        while (queue.length > 0) {
          const currId = queue.shift();
          const currGen = genMap[currId];
          const person = state.people[currId];
          if (!person) continue;

          // 配偶同代
          (person.spouseUnionIds || []).forEach(uid => {
            const u = state.unions[uid];
            if (!u) return;
            u.partners.forEach(pid => {
              if (!visited.has(pid)) {
                visited.add(pid);
                genMap[pid] = currGen;
                queue.push(pid);
              }
            });
            // 子女下一代 (+1)
            u.children.forEach(cid => {
              if (!visited.has(cid)) {
                visited.add(cid);
                genMap[cid] = currGen + 1;
                queue.push(cid);
              }
            });
          });

          // 父母上一代 (-1) 及同胞兄弟姐妹同代
          if (person.parentUnionId) {
            const pu = state.unions[person.parentUnionId];
            if (pu) {
              pu.partners.forEach(pid => {
                if (!visited.has(pid)) {
                  visited.add(pid);
                  genMap[pid] = currGen - 1;
                  queue.push(pid);
                }
              });
              pu.children.forEach(sibId => {
                if (!visited.has(sibId)) {
                  visited.add(sibId);
                  genMap[sibId] = currGen;
                  queue.push(sibId);
                }
              });
            }
          }
        }
      });

      // 归一化世代编号，使最年长的一代为「第 1 世」
      let minRawGen = Math.min(...Object.values(genMap));
      let maxGen = 1;
      peopleIds.forEach(id => {
        genMap[id] = genMap[id] - minRawGen + 1;
        if (genMap[id] > maxGen) maxGen = genMap[id];
      });

      // 2. 构建递归子树宽度测量与横向排布 (确保子女按数组顺序严格从左到右排列)
      const placedPeople = new Set();
      const nodePositions = {};
      const unionPositions = {};

      // 判断一个人是否是需要在顶层作为子树根起始的人物
      // 优先选择没有父母节点的顶层先祖开始向下递归布局
      const sortedPeopleIds = [...peopleIds].sort((a, b) => {
        if (genMap[a] !== genMap[b]) return genMap[a] - genMap[b];
        return 0;
      });

      // 构建家庭子树单元并进行后序遍历计算宽度
      function buildSubtree(primaryPersonId) {
        placedPeople.add(primaryPersonId);
        const person = state.people[primaryPersonId];
        const unions = (person.spouseUnionIds || [])
          .map(uid => state.unions[uid])
          .filter(Boolean);

        // 收集尚未被布局的配偶
        const spouses = [];
        unions.forEach(u => {
          u.partners.forEach(pid => {
            if (pid !== primaryPersonId && !placedPeople.has(pid) && state.people[pid]) {
              placedPeople.add(pid);
              spouses.push(pid);
            }
          });
        });

        // 夫妻并排组的总宽度
        const coupleCount = 1 + spouses.length;
        const coupleSpanW = coupleCount * LAYOUT_CFG.cardW + (coupleCount - 1) * LAYOUT_CFG.spouseGap;

        // 按顺序收集所有子女子树
        const childSubtrees = [];
        unions.forEach(u => {
          u.children.forEach(cid => {
            if (state.people[cid] && !placedPeople.has(cid)) {
              childSubtrees.push(buildSubtree(cid));
            }
          });
        });

        let childrenTotalW = 0;
        if (childSubtrees.length > 0) {
          childrenTotalW = childSubtrees.reduce((acc, st) => acc + st.width, 0) +
            (childSubtrees.length - 1) * LAYOUT_CFG.siblingGap;
        }

        const subtreeWidth = Math.max(coupleSpanW, childrenTotalW);

        return {
          primaryId: primaryPersonId,
          spouses,
          unions,
          coupleSpanW,
          childrenTotalW,
          childSubtrees,
          width: subtreeWidth
        };
      }

      function assignCoordinates(subtree, leftX) {
        const gen = genMap[subtree.primaryId] || 1;
        const centerY = (gen - 1) * LAYOUT_CFG.genGapY + 90;
        const centerX = leftX + subtree.width / 2;

        // 排列夫妻卡片
        const startCoupleX = centerX - subtree.coupleSpanW / 2 + LAYOUT_CFG.cardW / 2;
        const orderedCouple = [subtree.primaryId, ...subtree.spouses];

        orderedCouple.forEach((pid, idx) => {
          nodePositions[pid] = {
            x: startCoupleX + idx * (LAYOUT_CFG.cardW + LAYOUT_CFG.spouseGap),
            y: centerY,
            gen: genMap[pid]
          };
        });

        // 递归排列下一代子树（严格遵照 children 数组顺序从左到右）
        if (subtree.childSubtrees.length > 0) {
          let childCursorX = centerX - subtree.childrenTotalW / 2;
          subtree.childSubtrees.forEach(childSt => {
            assignCoordinates(childSt, childCursorX);
            childCursorX += childSt.width + LAYOUT_CFG.siblingGap;
          });
        }
      }

      let globalCursorX = 80;
      sortedPeopleIds.forEach(pid => {
        if (!placedPeople.has(pid)) {
          const rootTree = buildSubtree(pid);
          assignCoordinates(rootTree, globalCursorX);
          globalCursorX += rootTree.width + LAYOUT_CFG.siblingGap * 1.5;
        }
      });

      // 计算每个婚姻 Union 的连接锚点坐标
      Object.values(state.unions).forEach(u => {
        const validPartners = u.partners.filter(pid => nodePositions[pid]);
        if (validPartners.length === 0) return;

        const avgX = validPartners.reduce((sum, pid) => sum + nodePositions[pid].x, 0) / validPartners.length;
        const avgY = validPartners[0] ? nodePositions[validPartners[0]].y : 0;
        unionPositions[u.id] = { x: avgX, y: avgY };
      });

      return {
        nodes: nodePositions,
        unions: unionPositions,
        genMap,
        minGen: 1,
        maxGen
      };
    }

    /* ==================== 渲染视图（画布世代条、SVG 连线、人物卡片、右侧面板） ==================== */

    function renderAll() {
      // 确保 selectedId 有效
      const allIds = Object.keys(state.people);
      if (allIds.length === 0) return;
      if (!state.selectedId || !state.people[state.selectedId]) {
        state.selectedId = allIds[0];
      }
      if (!state.focusId || !state.people[state.focusId]) {
        state.focusId = state.selectedId;
      }

      const layout = computeFamilyTreeLayout();
      latestNodePositions = layout.nodes;

      renderGenerationBands(layout);
      renderConnectionsSvg(layout);
      renderPersonNodes(layout);
      renderInspectorPanel(layout);
      updateTopStats(allIds.length, layout.maxGen);
    }

    // 渲染新中式世代背景横栏（第 1 世、第 2 世...）
    function renderGenerationBands(layout) {
      const layer = document.getElementById('generationBandsLayer');
      layer.innerHTML = '';

      const xs = Object.values(layout.nodes).map(n => n.x);
      const minX = xs.length ? Math.min(...xs) - 220 : 0;
      const maxX = xs.length ? Math.max(...xs) + 220 : 1000;
      const width = Math.max(1200, maxX - minX);

      const cnGenNums = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十', '十一', '十二'];

      for (let g = 1; g <= layout.maxGen; g++) {
        const centerY = (g - 1) * LAYOUT_CFG.genGapY + 90;
        const topY = centerY - LAYOUT_CFG.genGapY / 2 + 12;
        const band = document.createElement('div');
        band.style.position = 'absolute';
        band.style.left = `${minX}px`;
        band.style.top = `${topY}px`;
        band.style.width = `${width}px`;
        band.style.height = `${LAYOUT_CFG.genGapY - 24}px`;
        band.className = 'rounded-2xl border border-[#e3d9c8]/70 bg-[#efeae1]/30 flex items-center px-4';

        const genTitle = cnGenNums[g - 1] ? `第${cnGenNums[g - 1]}世` : `第 ${g} 世`;
        band.innerHTML = `
          <div class="flex flex-col items-center justify-center w-8 py-2 rounded-lg bg-[#e5dec9]/80 border border-[#d4c8b4] text-[#5c5046] shadow-2xs">
            <span class="serif-title font-bold text-xs writing-vertical" style="writing-mode: vertical-rl; letter-spacing: 3px;">${genTitle}</span>
          </div>
        `;
        layer.appendChild(band);
      }
    }

    // 渲染婚姻连线与父子垂直折线
    function renderConnectionsSvg(layout) {
      const svg = document.getElementById('connectionsSvg');
      svg.innerHTML = '';

      Object.values(state.unions).forEach(u => {
        const partners = u.partners.filter(pid => layout.nodes[pid]);
        const children = u.children.filter(cid => layout.nodes[cid]);

        // 1. 绘制夫妻间婚姻双横线与同心结
        if (partners.length >= 2) {
          const sortedP = [...partners].sort((a, b) => layout.nodes[a].x - layout.nodes[b].x);
          const leftP = layout.nodes[sortedP[0]];
          const rightP = layout.nodes[sortedP[sortedP.length - 1]];

          // 婚姻红线
          const marriageLine = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const dMarriage = `M ${leftP.x} ${leftP.y} L ${rightP.x} ${rightP.y}`;
          marriageLine.setAttribute('d', dMarriage);
          marriageLine.setAttribute('stroke', '#c94a4a');
          marriageLine.setAttribute('stroke-width', '2.5');
          marriageLine.setAttribute('stroke-dasharray', '4,2');
          svg.appendChild(marriageLine);

          // 夫妻连线中点同心圆标记
          const midX = (leftP.x + rightP.x) / 2;
          const midY = (leftP.y + rightP.y) / 2;
          const heartCircle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          heartCircle.setAttribute('cx', midX);
          heartCircle.setAttribute('cy', midY);
          heartCircle.setAttribute('r', '7');
          heartCircle.setAttribute('fill', '#fdfbf7');
          heartCircle.setAttribute('stroke', '#c94a4a');
          heartCircle.setAttribute('stroke-width', '2');
          svg.appendChild(heartCircle);
        }

        // 2. 绘制从父母(或共祖连接点)到所有子女的世系折线
        if (children.length > 0 && partners.length > 0) {
          const sortedP = [...partners].sort((a, b) => layout.nodes[a].x - layout.nodes[b].x);
          const parentMidX = (layout.nodes[sortedP[0]].x + layout.nodes[sortedP[sortedP.length - 1]].x) / 2;
          const parentY = layout.nodes[sortedP[0]].y;

          // 如果只有单亲节点，从卡片底部出发；如果有夫妻双人，从夫妻连线中点出发
          const startY = partners.length >= 2 ? parentY : parentY + LAYOUT_CFG.cardH / 2;
          const firstChildY = layout.nodes[children[0]].y - LAYOUT_CFG.cardH / 2;
          const busY = parentY + (firstChildY - parentY) * 0.58;

          // 父母向下垂直干线
          const stemPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          stemPath.setAttribute('d', `M ${parentMidX} ${startY} L ${parentMidX} ${busY}`);
          stemPath.setAttribute('stroke', '#6e6259');
          stemPath.setAttribute('stroke-width', '2');
          stemPath.setAttribute('fill', 'none');
          svg.appendChild(stemPath);

          // 子女横向汇流母线 + 每个子女的垂直分支线
          const childXs = children.map(cid => layout.nodes[cid].x);
          const minChildX = Math.min(parentMidX, ...childXs);
          const maxChildX = Math.max(parentMidX, ...childXs);

          if (maxChildX > minChildX) {
            const busPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            busPath.setAttribute('d', `M ${minChildX} ${busY} L ${maxChildX} ${busY}`);
            busPath.setAttribute('stroke', '#6e6259');
            busPath.setAttribute('stroke-width', '2');
            busPath.setAttribute('fill', 'none');
            svg.appendChild(busPath);
          }

          children.forEach(cid => {
            const cPos = layout.nodes[cid];
            const childTopY = cPos.y - LAYOUT_CFG.cardH / 2;
            const dropPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            dropPath.setAttribute('d', `M ${cPos.x} ${busY} L ${cPos.x} ${childTopY}`);
            dropPath.setAttribute('stroke', '#6e6259');
            dropPath.setAttribute('stroke-width', '2');
            dropPath.setAttribute('fill', 'none');
            svg.appendChild(dropPath);

            // 子女顶部小圆点装饰
            const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            dot.setAttribute('cx', cPos.x);
            dot.setAttribute('cy', childTopY);
            dot.setAttribute('r', '3');
            dot.setAttribute('fill', '#6e6259');
            svg.appendChild(dot);
          });
        }
      });
    }

    // 渲染每个族人卡片节点
    function renderPersonNodes(layout) {
      const container = document.getElementById('nodesContainer');
      container.innerHTML = '';

      Object.keys(state.people).forEach(pid => {
        const person = state.people[pid];
        const pos = layout.nodes[pid];
        if (!pos) return;

        // 计算该人物在其同胞兄弟姐妹中的排行标签（如 长子、次子、长女）
        let rankBadgeHtml = '';
        if (person.parentUnionId && state.unions[person.parentUnionId]) {
          const siblings = state.unions[person.parentUnionId].children;
          const idx = siblings.indexOf(pid);
          if (idx !== -1) {
            const rankLabel = getRankLabel(idx, person.gender, siblings.length);
            rankBadgeHtml = `<span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-[#efeae1] text-[#5c5046] border border-[#dcd3c6]">${rankLabel}</span>`;
          }
        }

        const isSelected = state.selectedId === pid;
        const isFocus = state.focusId === pid;
        const isFemale = person.gender === 'F';

        const borderColor = isFemale ? 'border-[#d6a2ad]' : 'border-[#9ab3c2]';
        const topAccentBg = isFemale ? 'bg-[#a84253]' : 'bg-[#2b5973]';
