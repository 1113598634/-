  <!-- 隐藏的离屏导出画卷与打印容器（用于生成带卷首题跋的 PDF / PNG 及矢量打印） -->
  <div id="printableBookSection" class="hidden"></div>

  <script>
    /********************************************************************
     * 数据模型说明 (Multi-Book Family Tree Graph & Hierarchy Model)
     * ------------------------------------------------------------------
     * multiBookStore: {
     *   activeBookId: 'book_1',
     *   books: {
     *     'book_1': {
     *       id, title, subtitle, updatedAt,
     *       people: { ... }, unions: { ... }, selectedId, focusId
     *     }
     *   }
     * }
     ********************************************************************/
    const STORAGE_KEY_V2 = 'YUANLIU_MULTI_CLAN_BOOKS_V2';
    const LEGACY_STORAGE_KEY = 'YUANLIU_FAMILY_TREE_V1';

    let library = {
      activeBookId: null,
      books: {}
    };

    // 当前激活族谱的引用 (保持与原有逻辑无缝兼容)
    let state = {
      people: {},
      unions: {},
      selectedId: null,
      focusId: null
    };

    // 画布平移与缩放状态
    let viewportState = {
      x: 100,
      y: 80,
      scale: 1,
      isDragging: false,
      startX: 0,
      startY: 0
    };

    // 布局常量参数
    const LAYOUT_CFG = {
      cardW: 148,
      cardH: 88,
      spouseGap: 36,     // 夫妻卡片横向间距
      siblingGap: 44,    // 同辈相邻子树间距
      genGapY: 165       // 世代层垂直间距
    };

    // 记录最近一次布局后每个人物的中心坐标，用于居中定位
    let latestNodePositions = {};

    /* ==================== 初始化与多族谱数据迁移 ==================== */
    window.addEventListener('DOMContentLoaded', () => {
      initCanvasInteractions();
      initSearchEvents();
      initMultiBookLibrary();
    });

    // 确保任意族谱对象内部至少包含一位有效人物节点，防止空谱导致布局或导出报错
    function ensureValidBookData(book) {
      if (!book) return;
      if (!book.unions || typeof book.unions !== 'object') {
        book.unions = {};
      }
      if (!book.people || typeof book.people !== 'object' || Object.keys(book.people).length === 0) {
        if (book.id === 'book_demo_su' || (book.title && book.title.includes('苏氏'))) {
          const demo = buildFourGenDemoBookObject(book.id, book.title || '苏氏家乘·四世同堂', book.subtitle || '眉山堂 · 字辈：文、明、景、念');
          book.people = demo.people;
          book.unions = demo.unions;
          book.selectedId = demo.selectedId;
          book.focusId = demo.focusId;
        } else {
          const surname = book.title ? book.title.trim().charAt(0) : '林';
          const fallback = buildSingleFounderBookObject(
            book.id || generateId('book'),
            book.title || `${surname}氏宗谱`,
            book.subtitle || '源远流长 · 世系大典',
            `${surname}怀远`,
            'M',
            1960,
            '一世始祖 · 中心人物'
          );
          book.people = fallback.people;
          book.unions = fallback.unions;
          book.selectedId = fallback.selectedId;
          book.focusId = fallback.focusId;
        }
      }
      const pIds = Object.keys(book.people);
      if (!book.selectedId || !book.people[book.selectedId]) {
        book.selectedId = pIds[0];
      }
      if (!book.focusId || !book.people[book.focusId]) {
        book.focusId = book.selectedId;
      }
    }

    function initMultiBookLibrary() {
      const savedV2 = localStorage.getItem(STORAGE_KEY_V2);
      if (savedV2) {
        try {
          const parsed = JSON.parse(savedV2);
          if (parsed && parsed.books && Object.keys(parsed.books).length > 0) {
            library = parsed;
            Object.values(library.books).forEach(b => ensureValidBookData(b));
            const targetId = library.books[library.activeBookId] ? library.activeBookId : Object.keys(library.books)[0];
            activateClanBook(targetId, true);
            return;
          }
        } catch (e) {
          console.error('读取多族谱库失败', e);
        }
      }

      // 兼容旧版单族谱缓存平滑升级
      const legacySaved = localStorage.getItem(LEGACY_STORAGE_KEY);
      if (legacySaved) {
        try {
          const parsedLegacy = JSON.parse(legacySaved);
          if (parsedLegacy && parsedLegacy.people && Object.keys(parsedLegacy.people).length > 0) {
            const firstPerson = parsedLegacy.people[parsedLegacy.focusId] || Object.values(parsedLegacy.people)[0];
            const surname = firstPerson && firstPerson.name ? firstPerson.name.charAt(0) : '源流';
            const bookId = 'book_legacy_' + Date.now();
            library.books[bookId] = {
              id: bookId,
              title: `${surname}氏宗谱·珍藏本`,
              subtitle: '传承世系 · 枝繁叶茂',
              updatedAt: Date.now(),
              people: parsedLegacy.people,
              unions: parsedLegacy.unions || {},
              selectedId: parsedLegacy.selectedId,
              focusId: parsedLegacy.focusId
            };
            library.activeBookId = bookId;
            saveState();
            activateClanBook(bookId, true);
            return;
          }
        } catch (e) {
          console.warn('迁移旧版数据失败', e);
        }
      }

      // 首次访问：初始化两部示范族谱（一部四世同堂苏氏家乘 + 一部单人始祖陈氏族谱）供用户体验切换
      const demoBook = buildFourGenDemoBookObject('book_demo_su', '苏氏家乘·四世同堂', '眉山堂 · 字辈：文、明、景、念');
      const secondBook = buildSingleFounderBookObject('book_demo_chen', '颖川陈氏宗谱', '德星堂 · 始迁祖世系', '陈元光', 'M', 1955, '开基始祖');

      library.books[demoBook.id] = demoBook;
      library.books[secondBook.id] = secondBook;
      library.activeBookId = demoBook.id;

      saveState();
      activateClanBook(demoBook.id, true);
    }

    // 构建一部四世同堂示例族谱对象
    function buildFourGenDemoBookObject(bookId, title, subtitle) {
      const p = {};
      const u = {};

      const addP = (id, name, gender, birthYear, courtesy, bio = '', isAlive = true, deathYear = '') => {
        p[id] = { id, name, gender, birthYear, deathYear, isAlive, courtesy, bio, parentUnionId: null, spouseUnionIds: [] };
      };
      const addU = (uid, partners, children) => {
        u[uid] = { id: uid, partners: [...partners], children: [...children] };
        partners.forEach(pid => {
          if (p[pid] && !p[pid].spouseUnionIds.includes(uid)) {
            p[pid].spouseUnionIds.push(uid);
          }
        });
        children.forEach(cid => {
          if (p[cid]) p[cid].parentUnionId = uid;
        });
      };

      addP('p_gf', '苏文渊', 'M', 1932, '字伯涵 · 一世祖', '世代书香，定居江南。', false, 2016);
      addP('p_gm', '叶婉清', 'F', 1935, '一品贤淑', '温良恭俭，持家有道。', false, 2019);

      addP('p_uncle', '苏明轩', 'M', 1956, '长子 · 孟房', '酷爱金石书画。');
      addP('p_father', '苏明远', 'M', 1960, '次子 · 仲房 (中心)', '家族修谱主持者。');
      addP('p_mother', '周雅琴', 'F', 1962, '仲房正室', '中学高级教师。');
      addP('p_aunt', '苏明月', 'F', 1966, '长女 · 季房', '旅居海外学者。');

      addP('p_c1', '苏景行', 'M', 1986, '长子 · 景字辈', '建筑设计师。');
      addP('p_c1_w', '陈若水', 'F', 1988, '景行之妻', '园林设计师。');
      addP('p_c2', '苏景云', 'F', 1990, '长女 · 景字辈', '临床医师。');
      addP('p_c3', '苏景曜', 'M', 1994, '次子 · 景字辈', '人工智能研究员。');

      addP('p_g1', '苏念慈', 'F', 2015, '长孙女 · 念字辈', '聪颖好学。');
      addP('p_g2', '苏念祖', 'M', 2018, '长孙 · 念字辈', '活泼开朗。');

      addU('u_gen1', ['p_gf', 'p_gm'], ['p_uncle', 'p_father', 'p_aunt']);
      addU('u_gen2', ['p_father', 'p_mother'], ['p_c1', 'p_c2', 'p_c3']);
      addU('u_gen3', ['p_c1', 'p_c1_w'], ['p_g1', 'p_g2']);

      return {
        id: bookId,
        title,
        subtitle,
        updatedAt: Date.now(),
        people: p,
        unions: u,
        selectedId: 'p_father',
        focusId: 'p_father'
      };
    }

    // 构建一部单人起点的族谱对象
    function buildSingleFounderBookObject(bookId, title, subtitle, founderName, founderGender, founderYear, founderCourtesy) {
      const rootId = 'p_origin_' + Math.random().toString(36).substring(2, 7);
      return {
        id: bookId,
        title: title || `${founderName.charAt(0)}氏宗谱`,
        subtitle: subtitle || '源远流长 · 世系大典',
        updatedAt: Date.now(),
        people: {
          [rootId]: {
            id: rootId,
            name: founderName || '林怀远',
            gender: founderGender || 'M',
            birthYear: founderYear ? Number(founderYear) : 1960,
            deathYear: '',
            isAlive: true,
            courtesy: founderCourtesy || '一世始祖 · 中心人物',
            bio: '点击右侧面板可随时添加父母、配偶、兄弟姐妹及子女。',
            parentUnionId: null,
            spouseUnionIds: []
          }
        },
        unions: {},
        selectedId: rootId,
        focusId: rootId
      };
    }

    // 激活并切换到指定族谱
    function activateClanBook(bookId, fitDelay = true) {
      const book = library.books[bookId];
      if (!book) return;

      ensureValidBookData(book);

      library.activeBookId = bookId;
      state.people = book.people;
      state.unions = book.unions;
      state.selectedId = book.selectedId;
      state.focusId = book.focusId;

      // 更新顶部标题栏展示
      document.getElementById('currentBookTitleDisplay').textContent = book.title || '未命名族谱';
      document.getElementById('currentBookNoteDisplay').textContent = book.subtitle || '点击人物卡片添加血亲姻亲 · 拖拽调整长幼排行';

      saveState();
      renderAll();
      if (fitDelay) {
        setTimeout(fitFullTree, 60);
      }
    }

    function saveState() {
      try {
        if (library.activeBookId && library.books[library.activeBookId]) {
          const activeBook = library.books[library.activeBookId];
          activeBook.people = state.people;
          activeBook.unions = state.unions;
          activeBook.selectedId = state.selectedId;
          activeBook.focusId = state.focusId;
          activeBook.updatedAt = Date.now();
        }
        localStorage.setItem(STORAGE_KEY_V2, JSON.stringify(library));
      } catch (e) {
        console.warn('保存至 localStorage 失败', e);
      }
    }

    function generateId(prefix = 'p') {
      return prefix + '_' + Math.random().toString(36).substring(2, 9) + Date.now().toString(36).slice(-3);
    }

    // 重置当前打开的族谱为仅含 1 个中心始祖人物的初始状态
    function resetSingleOrigin() {
      const currentBook = library.books[library.activeBookId];
      const bookName = currentBook ? currentBook.title : '当前族谱';
      showConfirmDialog(
        '重置当前族谱为单人始祖',
        `确定清空《${bookName}》中的所有节点，并从单个中心人物重新开始构建吗？（您的其他族谱不受影响）`,
        () => {
          const rootId = generateId('p');
          const surname = currentBook && currentBook.title ? currentBook.title.charAt(0) : '林';
          state.people = {
            [rootId]: {
              id: rootId,
              name: `${surname}怀远`,
              gender: 'M',
              birthYear: 1965,
              deathYear: '',
              isAlive: true,
              courtesy: '本支始迁祖 · 中心人物',
              bio: '点击右侧面板可随时添加父母、配偶、兄弟姐妹及子女。',
              parentUnionId: null,
              spouseUnionIds: []
            }
          };
