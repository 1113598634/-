    // 导出 JSON 族谱备份（支持仅导出当前族谱 或 导出全部族谱库）
    function exportData(exportAllLibrary = false) {
      const currentBook = library.books[library.activeBookId];
      const payload = exportAllLibrary ? library : {
        ...currentBook,
        people: state.people,
        unions: state.unions,
        selectedId: state.selectedId,
        focusId: state.focusId
      };

      const dataStr = JSON.stringify(payload, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const fileName = exportAllLibrary
        ? `源流宗谱_全部谱籍库备份_${new Date().toISOString().slice(0, 10)}.json`
        : `${currentBook?.title || '家族'}_族谱备份.json`;
      a.href = url;
      a.download = fileName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('JSON 族谱备份文件已导出');
    }

    // 导入 JSON 族谱恢复（自动识别是单部族谱还是多谱籍库）
    function importData(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          if (parsed && parsed.books && Object.keys(parsed.books).length > 0) {
            // 导入的是完整多族谱库
            Object.entries(parsed.books).forEach(([bid, bObj]) => {
              library.books[bid] = bObj;
            });
            const targetId = parsed.activeBookId && library.books[parsed.activeBookId]
              ? parsed.activeBookId
              : Object.keys(parsed.books)[0];
            activateClanBook(targetId, true);
            closeExportCenterModal();
            showToast(`成功导入 ${Object.keys(parsed.books).length} 部族谱数据`);
            return;
          }

          if (parsed && parsed.people && Object.keys(parsed.people).length > 0) {
            // 导入的是单部族谱文件，作为一部新族谱加入库中
            const newBookId = generateId('book');
            const firstPerson = parsed.people[parsed.focusId] || Object.values(parsed.people)[0];
            const defaultTitle = parsed.title || `${firstPerson?.name ? firstPerson.name.charAt(0) : '新'}氏宗谱 (导入)`;
            library.books[newBookId] = {
              id: newBookId,
              title: defaultTitle,
              subtitle: parsed.subtitle || '外部导入族谱数据',
              updatedAt: Date.now(),
              people: parsed.people,
              unions: parsed.unions || {},
              selectedId: parsed.selectedId || Object.keys(parsed.people)[0],
              focusId: parsed.focusId || Object.keys(parsed.people)[0]
            };
            activateClanBook(newBookId, true);
            closeExportCenterModal();
            showToast(`已导入族谱《${defaultTitle}》`);
            return;
          }

          showToast('导入失败：JSON 文件格式无效');
        } catch (err) {
          showToast('解析 JSON 文件失败，请检查文件格式');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    // 自定义确认弹窗
    function showConfirmDialog(title, message, onConfirm) {
      const modal = document.getElementById('customDialogModal');
      document.getElementById('dialogTitle').textContent = title;
      document.getElementById('dialogMessage').textContent = message;

      const cancelBtn = document.getElementById('dialogCancelBtn');
      const confirmBtn = document.getElementById('dialogConfirmBtn');

      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      cancelBtn.onclick = close;
      confirmBtn.onclick = () => {
        close();
        if (typeof onConfirm === 'function') onConfirm();
      };

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    // 顶部轻提示
    let toastTimer = null;
    function showToast(msg) {
      const banner = document.getElementById('toastBanner');
      document.getElementById('toastText').textContent = msg;
      banner.classList.remove('opacity-0', '-translate-y-2');
      banner.classList.add('opacity-100', 'translate-y-0');

      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        banner.classList.remove('opacity-100', 'translate-y-0');
        banner.classList.add('opacity-0', '-translate-y-2');
      }, 2400);
    }

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
  </script>
</body>
