    /* ==================== 画布拖拽、滚轮缩放与自适应居中 ==================== */

    function initCanvasInteractions() {
      const vp = document.getElementById('canvasViewport');

      vp.addEventListener('mousedown', (e) => {
        if (e.target.closest('.person-card') || e.target.closest('button')) return;
        viewportState.isDragging = true;
        viewportState.startX = e.clientX - viewportState.x;
        viewportState.startY = e.clientY - viewportState.y;
      });

      window.addEventListener('mousemove', (e) => {
        if (!viewportState.isDragging) return;
        viewportState.x = e.clientX - viewportState.startX;
        viewportState.y = e.clientY - viewportState.startY;
        applyViewportTransform();
      });

      window.addEventListener('mouseup', () => {
        viewportState.isDragging = false;
      });

      // 触摸屏拖拽支持
      vp.addEventListener('touchstart', (e) => {
        if (e.target.closest('.person-card') || e.target.closest('button')) return;
        if (e.touches.length === 1) {
          viewportState.isDragging = true;
          viewportState.startX = e.touches[0].clientX - viewportState.x;
          viewportState.startY = e.touches[0].clientY - viewportState.y;
        }
      }, { passive: true });

      window.addEventListener('touchmove', (e) => {
        if (!viewportState.isDragging || e.touches.length !== 1) return;
        viewportState.x = e.touches[0].clientX - viewportState.startX;
        viewportState.y = e.touches[0].clientY - viewportState.startY;
        applyViewportTransform();
      }, { passive: true });

      window.addEventListener('touchend', () => {
        viewportState.isDragging = false;
      });

      // 鼠标滚轮缩放
      vp.addEventListener('wheel', (e) => {
        e.preventDefault();
        const delta = e.deltaY < 0 ? 0.1 : -0.1;
        zoomCanvas(delta, e.clientX, e.clientY);
      }, { passive: false });
    }

    function applyViewportTransform() {
      const el = document.getElementById('canvasTransform');
      el.style.transform = `translate(${viewportState.x}px, ${viewportState.y}px) scale(${viewportState.scale})`;
      document.getElementById('zoomLevelText').textContent = `${Math.round(viewportState.scale * 100)}%`;
    }

    function zoomCanvas(delta, clientX, clientY) {
      const vp = document.getElementById('canvasViewport');
      const rect = vp.getBoundingClientRect();
      const centerX = clientX !== undefined ? clientX - rect.left : rect.width / 2;
      const centerY = clientY !== undefined ? clientY - rect.top : rect.height / 2;

      const oldScale = viewportState.scale;
      const newScale = Math.min(1.8, Math.max(0.35, oldScale + delta));
      if (newScale === oldScale) return;

      // 围绕鼠标位置或中心点缩放
      viewportState.x = centerX - ((centerX - viewportState.x) / oldScale) * newScale;
      viewportState.y = centerY - ((centerY - viewportState.y) / oldScale) * newScale;
      viewportState.scale = newScale;
      applyViewportTransform();
    }

    function centerViewOnSelected() {
      const pos = latestNodePositions[state.selectedId];
      if (!pos) return;
      const vp = document.getElementById('canvasViewport');
      const rect = vp.getBoundingClientRect();

      viewportState.x = rect.width / 2 - pos.x * viewportState.scale;
      viewportState.y = rect.height / 2 - pos.y * viewportState.scale;
      applyViewportTransform();
    }

    function fitFullTree() {
      const positions = Object.values(latestNodePositions);
      if (positions.length === 0) return;

      const vp = document.getElementById('canvasViewport');
      const rect = vp.getBoundingClientRect();

      const minX = Math.min(...positions.map(p => p.x)) - LAYOUT_CFG.cardW;
      const maxX = Math.max(...positions.map(p => p.x)) + LAYOUT_CFG.cardW;
      const minY = Math.min(...positions.map(p => p.y)) - LAYOUT_CFG.cardH;
      const maxY = Math.max(...positions.map(p => p.y)) + LAYOUT_CFG.cardH;

      const treeW = Math.max(300, maxX - minX);
      const treeH = Math.max(240, maxY - minY);

      const scaleX = (rect.width * 0.86) / treeW;
      const scaleY = (rect.height * 0.82) / treeH;
      const targetScale = Math.min(1.15, Math.max(0.45, Math.min(scaleX, scaleY)));

      const treeCenterX = (minX + maxX) / 2;
      const treeCenterY = (minY + maxY) / 2;

      viewportState.scale = targetScale;
      viewportState.x = rect.width / 2 - treeCenterX * targetScale;
      viewportState.y = rect.height / 2 - treeCenterY * targetScale;
      applyViewportTransform();
    }

